{
  "name": "markdown-rbmk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Your GitHub activity rendered as an animated RBMK reactor-core SVG badge",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:fn": "ncc build packages/server/api/badge.ts -o .fn-build --minify --transpile-only && node scripts/move-fn-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "pnpm --filter @markdown-rbmk/core preview"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@vercel/ncc": "0.45.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
